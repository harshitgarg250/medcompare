
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  phone                String?
  password             String?
  profilePicture       String?
  authProvider         String    @default("email")
  googleId             String?   @unique
  resetPasswordOtpHash String?
  resetPasswordExpires DateTime?
  role                 Role      @default(USER)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  bookings             Booking[]
  reviews              Review[]
  reports              Report[]
  aIConversations      AIConversation[]
}

enum Role {
  USER
  ADMIN
  HOSPITAL
}

model Hospital {
  id                   Int           @id @default(autoincrement())
  name                 String
  type                 String
  address              String
  city                 String
  lat                  Float
  lng                  Float
  phone                String?
  email                String?
  rating               Float         @default(0)
  isVerified           Boolean       @default(false)
  isOpen               Boolean       @default(true)
  homeServiceAvailable Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tests                TestPrice[]
  slots                Slot[]
  bookings             Booking[]
  reviews              Review[]
  reports              Report[]
}

model TestPrice {
  id         Int      @id @default(autoincrement())
  testId     Int
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  price      Float
  testName   String?

  @@unique([testId, hospitalId])
}

model Test {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  prices      TestPrice[]
}

model Slot {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  date       DateTime
  time       String
  isBooked   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Booking {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId      Int
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  testId          Int?
  status          String   @default("pending")
  appointmentDate DateTime
  slot            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reports         Report[]
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId Int
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reportUrl String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId Int
  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model AIConversation {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  message   String  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}
